{
  "name": "speak-shine-monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "version": "1.0.0",
  "description": "Speak & Shine - AI-powered speech analysis platform",
  "main": "apps/backend/dist/apps/backend/src/main.js",
  "type": "module",
  "scripts": {
    "build": "npm run build:packages && npm run build:backend && npm run build:web",
    "build:packages": "npm run --prefix packages/shared-types build && npm run --prefix packages/validation-schemas build && npm run --prefix packages/ui-kit build",
    "build:backend": "npm run --prefix apps/backend build",
    "build:web": "npm run --prefix apps/web-student build && npm run --prefix apps/web-trainer build && npm run --prefix apps/web-admin build",
    "build:student": "npm run --prefix apps/web-student build",
    "build:trainer": "npm run --prefix apps/web-trainer build",
    "build:admin": "npm run --prefix apps/web-admin build",
    "start": "node apps/backend/dist/apps/backend/src/main.js",
    "start:backend": "node apps/backend/dist/apps/backend/src/main.js",
    "dev:backend": "npm run --prefix apps/backend start:dev",
    "dev:student": "npm run --prefix apps/web-student dev",
    "dev:trainer": "npm run --prefix apps/web-trainer dev",
    "dev:admin": "npm run --prefix apps/web-admin dev",
    "test": "vitest run apps/backend/src/"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/lib-storage": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@hapi/boom": "^9.1.4",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "argon2": "^0.41.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "file-type": "^21.3.4",
    "groq-sdk": "^0.8.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.10.0",
    "mongoose": "^8.3.0",
    "msedge-tts": "^1.3.4",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.7",
    "pino": "^9.14.0",
    "qrcode": "^1.5.3",
    "qrcode-terminal": "^0.12.0",
    "razorpay": "^2.9.6",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3"
  },
  "optionalDependencies": {
    "canvas": "^3.2.3"
  },
  "devDependencies": {
    "fast-check": "^4.7.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.5"
  },
  "directories": {
    "doc": "docs"
  },
  "author": "",
  "license": "ISC"
}
